# Copy to .env.production (ignored by Git), chmod 600, and supply fresh secrets.
# Pass it to Compose with: docker compose --env-file .env.production ...
ELEMARKET_ENV=production
ELEMARKET_EXEC_FACE_ENABLED=0
ELEMARKET_PORTAL_HOST_ROUTING=1
# Replace all hostnames with domains you control; these are only examples.
ELEMARKET_DOMAIN=marketplace.example.com
ELEMARKET_EXECUTIVE_HOST=festus.example.com
ELEMARKET_STAFF_HOST=staff.example.com
ELEMARKET_SELLER_HOST=seller.example.com
ELEMARKET_PROVIDER_HOST=partners.example.com
BETTER_AUTH_URL=https://marketplace.example.com
# Exact verified database identity, never an email or an arbitrary owner grant.
ELEMARKET_EXECUTIVE_USER_ID=
ELEMARKET_DB_NAME=elemarket
ELEMARKET_DB_USER=elemarket
# Use URL-safe random hex secrets because Compose constructs connection URLs.
ELEMARKET_DB_PASSWORD=
ELEMARKET_REDIS_PASSWORD=
BETTER_AUTH_SECRET=
CRON_SECRET=
ELEMARKET_MERCHANT_DATA_ENCRYPTION_KEY=
ELEMARKET_FINANCING_DATA_ENCRYPTION_KEY=
ELEMARKET_ENTERPRISE_SYNC_SECRET=
# Compose supplies DATABASE_URL, REDIS_URL and trusted-proxy settings to app.
# Email, SMS, storage, location and push adapters are optional configuration;
# unconfigured operations fail closed. Public signup needs verified delivery.
# Consult config/provider-capabilities.json for each selected adapter's inputs.
# Never put private values in VITE_* variables. Never enable preview settlement.

# Mandatory for universal rider-triggered handover OTP in shared deployments.
# Generate with: openssl rand -hex 32; keep the key STABLE across restarts.
ELEMARKET_HANDOVER_OTP_HMAC_KEY=
ELEMARKET_HANDOVER_SMS_PROVIDER=
# Configure the registered SMS provider's API secret in private runtime secrets.
ARKESEL_API_KEY=
ARKESEL_OTP_SENDER_ID=ELEMARKET

# HTTPS origin hosting the authenticated provider rider-acceptance page.
ELEMARKET_RIDER_PORTAL_ORIGIN=

# Reviewed HTTPS origins for externally hosted product images (space/comma separated).
# Only hosted assets from these exact origins are shown; local /api/product-media works without it.
# This public value must be present when building Vite AND in runtime CSP configuration.
# Leave empty to block partner-hosted third-party image tracking by default.
VITE_ELEMARKET_PUBLIC_MEDIA_ORIGINS=

# Payment driver configuration (server runtime only; no secrets in source).
# Apply migrations with npm run db:migrate to assign registry driver keys.
# Preserve other allowlisted modules when adding this entry to an existing deployment.
ELEMARKET_PAYMENT_ALLOWED_MODULES=builtin:paystack
ELEMARKET_PAYMENT_DRIVER_PAYSTACK_MODULE=builtin:paystack
ELEMARKET_PAYMENT_PAYSTACK_DRIVER=paystack
ELEMARKET_PAYMENT_PAYSTACK_CARD_DRIVER=paystack
ELEMARKET_PAYMENT_PAYSTACK_BANK_TRANSFER_DRIVER=paystack
# Set each enabled method's secret to the same Paystack account secret via your host.
ELEMARKET_PAYMENT_PAYSTACK_SECRET=
ELEMARKET_PAYMENT_PAYSTACK_CARD_SECRET=
ELEMARKET_PAYMENT_PAYSTACK_BANK_TRANSFER_SECRET=
# Exact allowed checkout hostname(s), comma-separated, without a URL scheme/path.
# Supply the verified checkout hostnames for your account before activation.
ELEMARKET_PAYMENT_PAYSTACK_CHECKOUT_HOSTS=
ELEMARKET_PAYMENT_PAYSTACK_CARD_CHECKOUT_HOSTS=
ELEMARKET_PAYMENT_PAYSTACK_BANK_TRANSFER_CHECKOUT_HOSTS=
# Callback origin uses BETTER_AUTH_URL above unless explicitly supplied here.
ELEMARKET_PUBLIC_URL=
