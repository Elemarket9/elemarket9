# Copy to .env.production (ignored by Git), chmod 600, and supply fresh secrets.
# Pass it to Compose with: docker compose --env-file .env.production ...
ELEMARKET_ENV=production
ELEMARKET_EXEC_FACE_ENABLED=0
ELEMARKET_PORTAL_HOST_ROUTING=1
# Replace all hostnames with domains you control; these are only examples.
ELEMARKET_DOMAIN=marketplace.example.com
ELEMARKET_EXECUTIVE_HOST=festus.example.com
ELEMARKET_STAFF_HOST=staff.example.com
ELEMARKET_SELLER_HOST=seller.example.com
ELEMARKET_PROVIDER_HOST=partners.example.com
BETTER_AUTH_URL=https://marketplace.example.com
# Exact verified database identity, never an email or an arbitrary owner grant.
ELEMARKET_EXECUTIVE_USER_ID=
ELEMARKET_DB_NAME=elemarket
ELEMARKET_DB_USER=elemarket
# Use URL-safe random hex secrets because Compose constructs connection URLs.
ELEMARKET_DB_PASSWORD=
ELEMARKET_REDIS_PASSWORD=
BETTER_AUTH_SECRET=
CRON_SECRET=
ELEMARKET_MERCHANT_DATA_ENCRYPTION_KEY=
ELEMARKET_FINANCING_DATA_ENCRYPTION_KEY=
ELEMARKET_ENTERPRISE_SYNC_SECRET=
# Compose supplies DATABASE_URL, REDIS_URL and trusted-proxy settings to app.
# Email, SMS, storage, location and push adapters are optional configuration;
# unconfigured operations fail closed. Public signup needs verified delivery.
# Consult config/provider-capabilities.json for each selected adapter's inputs.
# Never put private values in VITE_* variables. Never enable preview settlement.
