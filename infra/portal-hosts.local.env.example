# Set these in a local development environment (never commit real credentials).
# .test hostnames require local /etc/hosts entries; they are NOT publicly reachable.
ELEMARKET_PORTAL_HOST_ROUTING=1
ELEMARKET_DOMAIN=elemarket.test
ELEMARKET_EXECUTIVE_HOST=festus.elemarket.test
ELEMARKET_STAFF_HOST=staff.elemarket.test
ELEMARKET_SELLER_HOST=seller.elemarket.test
ELEMARKET_PROVIDER_HOST=partners.elemarket.test
# Copy the actual verified "user".id for the one executive administrator.
ELEMARKET_EXECUTIVE_USER_ID=REPLACE_WITH_VERIFIED_MAIN_ADMIN_USER_ID
# Better Auth uses its canonical origin for outgoing verification links;
# additional portal HTTPS origins are derived automatically when routing is enabled.
BETTER_AUTH_URL=https://elemarket.test

# Public, non-secret URLs compiled into navigation (same values for local SSR/SPA).
VITE_ELEMARKET_MARKETPLACE_ORIGIN=https://elemarket.test
VITE_ELEMARKET_SELLER_ORIGIN=https://seller.elemarket.test
VITE_ELEMARKET_PROVIDER_ORIGIN=https://partners.elemarket.test
# To test UI that explicitly labels and disables checkout:
VITE_ELEMARKET_LAUNCH_PROFILE=developer_beta

# Executive biometric authentication is intentionally off until the private
# identity-matching + independent presentation-attack-detection engine is vetted.
ELEMARKET_EXEC_FACE_ENABLED=0
# EIDE_EXEC_FACE_ENGINE_URL=https://private-face-engine.example/v1/verify
# EIDE_EXEC_FACE_ENGINE_SECRET=<unique-random-secret-at-least-32-characters>

# Required only after an independently reviewed private PAD + face matcher is available:
# EIDE_EXEC_FACE_ENGINE_POLICY_ID=your-reviewed-verifier-policy-2026

# OPEN-SOURCE MATCHER ADAPTER (CompreFace)
# This only connects matching. CompreFace does NOT provide qualified liveness/PAD.
# Keep biometric login OFF until an independently reviewed PAD service is connected.
COMPREFACE_BASE_URL=http://compreface:8000
# COMPREFACE_RECOGNITION_API_KEY=<recognition-service-key-from-private-compreface-console>
COMPREFACE_MATCH_THRESHOLD=0.85
# EIDE_EXEC_FACE_ENGINE_URL=http://executive-face-bridge:8091/v1/verify
# EIDE_EXEC_FACE_ENGINE_ALLOW_INTERNAL_HTTP=1  # Only the fixed internal Docker DNS name, port 8091.
# EIDE_EXEC_FACE_ENGINE_POLICY_ID=your-reviewed-evaluation-policy
# EIDE_EXEC_FACE_ENGINE_SECRET=<distinct-random-secret-at-least-32-characters>
# EIDE_EXEC_PAD_URL=https://private-evaluated-pad.example/v1/presentation-verify
# EIDE_EXEC_PAD_SECRET=<distinct-random-secret-at-least-32-characters>
# EIDE_EXEC_PAD_POLICY_ID=your-independently-reviewed-pad-policy

# Experimental passive/active PAD research adapter; never use production secrets in git.
# The optional Docker service is deliberately OFF by default.
# EIDE_EXEC_PAD_URL=http://pad-verifier:8092/v1/presentation-verify
# EIDE_EXEC_PAD_SECRET=<distinct-secret-minimum-32-characters>
# EIDE_EXEC_PAD_POLICY_ID=reviewed-policy-version-2026
# EIDE_PAD_INDEPENDENTLY_ASSESSED=0
# MINIVISION_PAD_MIN_LIVE_SCORE=0.85
# MINIVISION_PAD_YAW_SIGN=1
