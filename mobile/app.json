{
  "expo": {
    "name": "ELEMARKET",
    "slug": "elemarket",
    "version": "1.0.0",
    "scheme": "elemarket",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "android": {
      "package": "com.elevora.elemarket"
    },
    "ios": {
      "bundleIdentifier": "com.elevora.elemarket",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    }
  }
}
